{
  "name": "drjangmaritime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "resume:generate": "tsx scripts/generate-resume.mjs",
    "resume:print": "node scripts/print-resume.mjs",
    "resume:install-hook": "node -e \"require('fs').copyFileSync('scripts/git-hooks/pre-commit', '.git/hooks/pre-commit'); require('fs').chmodSync('.git/hooks/pre-commit', 0o755); console.log('resume pre-commit hook installed')\"",
    "prepare": "npm run resume:install-hook"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.124.0"
  }
}
