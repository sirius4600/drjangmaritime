# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / opennext
.open-next
.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts

# private source material (contains PII: resident registration number,
# home address, personal phone, signature) — never commit
/private-source-docs/

# local credentials — never commit
drjangmaritime-bot.txt

# local double-click launcher (opens the private/phone-included resume copy) — machine-specific, not site content
/이력서 출력.bat

# generated resume PDFs (real phone number baked in) — never commit
/*.pdf
